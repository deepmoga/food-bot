<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title || 'Admin Panel' %> — <%= locals.vendorName || 'Food Bot' %></title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--green:#1db954;--red:#e53935;--amber:#f59e0b;--blue:#3b82f6;--purple:#8b5cf6;--gray:#6b7280;--bg:#f3f4f6}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--bg);color:#111}
.sidebar{position:fixed;top:0;left:0;width:220px;height:100vh;background:#fff;border-right:1px solid #e5e7eb;padding:20px 0;z-index:100}
.sidebar .brand{padding:0 20px 20px;font-weight:700;font-size:18px;color:#111;border-bottom:1px solid #e5e7eb}
.sidebar .brand span{color:var(--green)}
.sidebar nav{padding:12px 0}
.sidebar nav a{display:flex;align-items:center;gap:10px;padding:10px 20px;color:#374151;text-decoration:none;font-size:14px;font-weight:500;transition:.15s}
.sidebar nav a:hover,.sidebar nav a.active{background:#f0fdf4;color:var(--green)}
.sidebar nav a .icon{width:18px;text-align:center}
.sidebar .bottom{position:absolute;bottom:0;left:0;right:0;padding:16px 20px;border-top:1px solid #e5e7eb;font-size:13px;color:#6b7280}
.sidebar .bottom a{color:var(--red);text-decoration:none;font-weight:500}
.main{margin-left:220px;padding:24px;min-height:100vh}
.page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}
.page-header h1{font-size:22px;font-weight:700}
.card{background:#fff;border-radius:12px;border:1px solid #e5e7eb;padding:20px;margin-bottom:20px}
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;border:none;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;text-decoration:none;transition:.15s}
.btn-primary{background:var(--green);color:#fff}.btn-primary:hover{background:#17a347}
.btn-danger{background:var(--red);color:#fff}.btn-danger:hover{background:#c62828}
.btn-amber{background:var(--amber);color:#fff}
.btn-blue{background:var(--blue);color:#fff}
.btn-sm{padding:5px 10px;font-size:12px}
.btn-ghost{background:#f3f4f6;color:#374151}.btn-ghost:hover{background:#e5e7eb}
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;padding:10px 12px;background:#f9fafb;border-bottom:2px solid #e5e7eb;font-weight:600;color:#374151;font-size:12px;text-transform:uppercase}
td{padding:10px 12px;border-bottom:1px solid #f3f4f6;vertical-align:middle}
tr:hover td{background:#fafafa}
.badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}
.badge-waiting{background:#fff3cd;color:#7d4e00;border:1.5px solid #f59e0b;font-weight:700}
.badge-confirmed{background:#cfe2ff;color:#003580;border:1.5px solid #3b82f6;font-weight:700}
.badge-preparing{background:#e9d5ff;color:#5b21b6;border:1.5px solid #8b5cf6;font-weight:700}
.badge-ready{background:#bbf7d0;color:#065f46;border:1.5px solid #22c55e;font-weight:700}
.badge-delivered{background:#d1fae5;color:#064e3b;border:1.5px solid #10b981;font-weight:700}
.badge-cancelled{background:#fee2e2;color:#7f1d1d;border:1.5px solid #ef4444;font-weight:700}
.badge-paid{background:#bbf7d0;color:#064e3b;border:1.5px solid #22c55e;font-weight:700}
.badge-cod{background:#fff3cd;color:#7d4e00;border:1.5px solid #f59e0b;font-weight:700}
.badge-pending{background:#f1f5f9;color:#475569;border:1.5px solid #94a3b8;font-weight:700}
.badge-cod_pending{background:#fff3cd;color:#7d4e00;border:1.5px solid #f59e0b;font-weight:700}
/* Status select colors */
select option[value="waiting"]{background:#fff3cd;color:#7d4e00}
select option[value="confirmed"]{background:#cfe2ff;color:#003580}
select option[value="preparing"]{background:#e9d5ff;color:#5b21b6}
select option[value="ready"]{background:#bbf7d0;color:#065f46}
select option[value="delivered"]{background:#d1fae5;color:#064e3b}
select option[value="cancelled"]{background:#fee2e2;color:#7f1d1d}
.form-group{margin-bottom:14px}
.form-group label{display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px}
.form-control{width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-family:inherit;font-size:13px;outline:none;transition:.15s}
.form-control:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(29,185,84,.1)}
select.form-control{cursor:pointer}
.alert{padding:10px 16px;border-radius:8px;font-size:13px;margin-bottom:16px}
.alert-success{background:#d1fae5;color:#065f46}
.alert-error{background:#fee2e2;color:#991b1b}
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center}
.modal-overlay.open{display:flex}
.modal{background:#fff;border-radius:16px;padding:24px;width:90%;max-width:500px;max-height:90vh;overflow-y:auto}
.modal h2{font-size:18px;font-weight:700;margin-bottom:16px}
.modal .close{float:right;cursor:pointer;font-size:20px;color:#6b7280;background:none;border:none;line-height:1}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
.stat-card{background:#fff;border-radius:12px;border:1px solid #e5e7eb;padding:16px}
.stat-card .label{font-size:12px;color:#6b7280;font-weight:500;margin-bottom:4px}
.stat-card .value{font-size:24px;font-weight:700}
.tabs{display:flex;gap:4px;margin-bottom:16px;flex-wrap:wrap}
.tab{padding:7px 14px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;text-decoration:none;color:#374151;background:#fff;border:1px solid #e5e7eb}
.tab.active{background:var(--green);color:#fff;border-color:var(--green)}
.search-box{position:relative;margin-bottom:16px}
.search-box input{width:100%;padding:9px 12px 9px 36px;border:1px solid #d1d5db;border-radius:8px;font-size:13px;font-family:inherit;outline:none}
.search-box input:focus{border-color:var(--green)}
.search-box::before{content:'🔍';position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:14px}
.toggle{position:relative;display:inline-block;width:44px;height:24px}
.toggle input{opacity:0;width:0;height:0}
.toggle .slider{position:absolute;cursor:pointer;inset:0;background:#d1d5db;border-radius:24px;transition:.3s}
.toggle .slider:before{content:'';position:absolute;width:18px;height:18px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.3s}
.toggle input:checked+.slider{background:var(--green)}
.toggle input:checked+.slider:before{transform:translateX(20px)}
@media(max-width:768px){.sidebar{transform:translateX(-100%)}.main{margin-left:0}.stats-grid{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<div class="sidebar">
  <div class="brand">🍽️ <span>Food</span>Bot</div>
  <nav>
    <a href="/admin" class="<%= page==='orders'?'active':'' %>"><span class="icon">📦</span> Orders</a>
    <a href="/admin/menu" class="<%= page==='menu'?'active':'' %>"><span class="icon">🍽️</span> Menu</a>
    <% if(locals.features && features.delivery_boys){ %>
    <a href="/admin/delivery" class="<%= page==='delivery'?'active':'' %>"><span class="icon">🛵</span> Delivery Boys</a>
    <% } %>
    <% if(locals.features && features.coupon_system){ %>
    <a href="/admin/coupons" class="<%= page==='coupons'?'active':'' %>"><span class="icon">🏷️</span> Coupons</a>
    <% } %>
    <a href="/admin/store-hours" class="<%= page==='storehours'?'active':'' %>"><span class="icon">🕐</span> Store Hours</a>
    <% if(locals.features && features.bill_generation){ %>
    <a href="/admin/bills" class="<%= page==='bills'?'active':'' %>"><span class="icon">🧾</span> Bills</a>
    <% } %>
    <a href="/admin/broadcast" class="<%= page==='broadcast'?'active':'' %>"><span class="icon">📢</span> Broadcast</a>
    <a href="/admin/settings" class="<%= page==='settings'?'active':'' %>"><span class="icon">⚙️</span> Settings</a>
    <a href="/admin/subscription" class="<%= page==='subscription'?'active':'' %>" style="border-top:1px solid #e5e7eb;margin-top:8px;padding-top:18px"><span class="icon">💬</span> Subscription</a>
  </nav>
  <div class="bottom">
    <% if(locals.subscription){ %>
    <% var _pct = locals.subscription.messages_total > 0 ? Math.round((locals.subscription.messages_used/locals.subscription.messages_total)*100) : 0; %>
    <div style="margin-bottom:8px">
      <div style="font-size:11px;font-weight:600;color:#374151;margin-bottom:3px">Messages: <%= locals.subscription.messages_used %>/<%= locals.subscription.messages_total %></div>
      <div style="background:#e5e7eb;border-radius:4px;height:5px">
        <div style="background:<%= _pct>=90?'#ef4444':_pct>=70?'#f59e0b':'#1db954' %>;height:100%;border-radius:4px;width:<%= Math.min(_pct,100) %>%"></div>
      </div>
    </div>
    <% } %>
    <%= locals.vendorName %><br>
    <a href="/admin/logout">Logout →</a>
  </div>
</div>
<div class="main">
  <%- body %>
</div>
<%- locals.scripts || '' %>

<!-- ===== GLOBAL NEW ORDER ALERT (all admin pages) ===== -->
<div id="g-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:99998"></div>
<div id="g-alert" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#fff;border:3px solid #1db954;border-radius:20px;padding:28px 32px;z-index:99999;min-width:320px;text-align:center;box-shadow:0 12px 50px rgba(0,0,0,.4)">
  <div style="font-size:44px;margin-bottom:8px">🔔</div>
  <div style="font-weight:700;font-size:20px;margin-bottom:6px">Naya Order Aaya!</div>
  <div id="g-alert-text" style="font-size:14px;color:#374151;background:#f9fafb;padding:12px;border-radius:10px;margin-bottom:20px;line-height:1.6"></div>
  <div style="display:flex;gap:10px;justify-content:center">
    <a href="/admin" onclick="dismissAlert()" style="background:#1db954;color:#fff;padding:10px 24px;border-radius:10px;font-weight:600;font-size:14px;text-decoration:none">✅ Orders Dekho</a>
    <button onclick="dismissAlert()" style="background:#f3f4f6;color:#374151;border:none;padding:10px 24px;border-radius:10px;font-weight:600;font-size:14px;cursor:pointer">⏰ Baad Mein</button>
  </div>
</div>

<script>
(function() {
  let lastId = 0;
  let beepTimer = null;
  let swReg = null;

  // Service Worker register
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js')
      .then(r => { swReg = r; })
      .catch(() => {});
  }

  // Notification permission
  if ('Notification' in window && Notification.permission === 'default') {
    Notification.requestPermission();
  }

  // Siren sound
  function playSiren() {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const g = ctx.createGain();
      g.gain.value = 1.0;
      g.connect(ctx.destination);
      for (let i = 0; i < 2; i++) {
        const o = ctx.createOscillator();
        o.connect(g);
        o.type = 'sawtooth';
        const t = ctx.currentTime + i * 0.9;
        o.frequency.setValueAtTime(600, t);
        o.frequency.linearRampToValueAtTime(1200, t + 0.4);
        o.frequency.linearRampToValueAtTime(600, t + 0.8);
        o.start(t);
        o.stop(t + 0.85);
      }
    } catch(e) {}
  }

  function showGlobalAlert(orders) {
    document.getElementById('g-alert-text').innerHTML =
      orders.map(o => '<strong>#' + o.order_number + '</strong> — ' + (o.customer_name || 'Customer') + ' — <strong>Rs.' + o.total + '</strong>').join('<br>');
    document.getElementById('g-alert').style.display = 'block';
    document.getElementById('g-overlay').style.display = 'block';
    document.title = '🔔 NEW ORDER! — Admin';
    playSiren();
    if (beepTimer) clearInterval(beepTimer);
    beepTimer = setInterval(playSiren, 4000);

    // System notification (browser minimize pe bhi)
    if ('Notification' in window && Notification.permission === 'granted') {
      const n = new Notification('New Order Aaya!', {
        body: orders.map(o => '#' + o.order_number + ' — Rs.' + o.total).join('\n'),
        requireInteraction: true,
        tag: 'foodbot-order'
      });
      n.onclick = function() { window.focus(); dismissAlert(); n.close(); };
    }

    // SW notification
    try {
      const sw = swReg && (swReg.active || swReg.waiting);
      if (sw) sw.postMessage({ type: 'NEW_ORDER', orders: orders });
    } catch(e) {}
  }

  window.dismissAlert = function() {
    if (beepTimer) { clearInterval(beepTimer); beepTimer = null; }
    document.getElementById('g-alert').style.display = 'none';
    document.getElementById('g-overlay').style.display = 'none';
    document.title = 'Admin Panel';
  };

  // Fetch lastId then start polling
  fetch('/admin/api/latest-order-id')
    .then(r => r.json())
    .then(d => { lastId = d.id || 0; })
    .catch(() => { lastId = 0; })
    .finally(() => {
      // Poll every 6s
      setInterval(async function() {
        try {
          const orders = await fetch('/admin/api/new-orders?since=' + lastId).then(r => r.json());
          if (orders && orders.length > 0) {
            lastId = orders[0].id;
            showGlobalAlert(orders);
          }
        } catch(e) {}
      }, 6000);
    });

  // BroadcastChannel — other tabs
  try {
    const bc = new BroadcastChannel('foodbot-global');
    bc.onmessage = function(e) {
      if (e.data && e.data.type === 'new-order') showGlobalAlert(e.data.orders);
    };
  } catch(e) {}
})();
</script>
</body>
</html>
