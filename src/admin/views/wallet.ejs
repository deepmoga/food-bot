<%
const page = 'wallet';
const title = 'Wallet';
const fromVal = (locals.query && locals.query.from) || '';
const toVal = (locals.query && locals.query.to) || '';
const body = `
<div class="page-header">
  <h1>💰 Wallet</h1>
</div>

<div class="card" style="background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;font-size:13px;line-height:1.6">
  Aapke online orders ka payment <strong>FoodBot ke gateway</strong> se collect hota hai — paisa FoodBot ke account
  mein aata hai aur baad mein aapko settle (transfer) kiya jata hai. Yahan aap dekh sakte ho ki kitna online payment
  aaya hai, kitna settle ho gaya hai, aur kitna pending hai.
</div>

<div class="stats-grid">
  <div class="stat-card"><div class="label">Total Online Payments</div><div class="value">₹${Number(totals.total_amount || 0).toLocaleString('en-IN')}</div></div>
  <div class="stat-card"><div class="label">Pending Settlement</div><div class="value" style="color:#d97706">₹${Number(totals.pending_amount || 0).toLocaleString('en-IN')}</div></div>
  <div class="stat-card"><div class="label">Settled (Received)</div><div class="value" style="color:#16a34a">₹${Number(totals.settled_amount || 0).toLocaleString('en-IN')}</div></div>
</div>

<div class="card">
  <form method="GET" style="display:flex;gap:10px;flex-wrap:wrap;align-items:end">
    <div class="form-group" style="margin-bottom:0">
      <label>From</label>
      <input type="date" name="from" class="form-control" value="${fromVal}">
    </div>
    <div class="form-group" style="margin-bottom:0">
      <label>To</label>
      <input type="date" name="to" class="form-control" value="${toVal}">
    </div>
    <button type="submit" class="btn btn-primary">🔍 Filter</button>
    <a href="/admin/wallet" class="btn btn-ghost">Reset</a>
  </form>
</div>

<div class="card" style="padding:0">
  <table>
    <thead><tr><th>Order #</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
    <tbody>
      ${rows.map(r => `
        <tr>
          <td>#${r.order_number}</td>
          <td>₹${Number(r.amount).toLocaleString('en-IN')}</td>
          <td><span class="badge ${r.settlement_status === 'settled' ? 'badge-delivered' : 'badge-waiting'}">${r.settlement_status === 'settled' ? '✅ Settled' : '⏳ Pending'}</span></td>
          <td style="color:#6b7280;font-size:12px">${new Date(r.created_at).toLocaleString('en-IN')}</td>
        </tr>
      `).join('')}
      ${!rows.length ? '<tr><td colspan="4" style="text-align:center;padding:32px;color:#6b7280">Abhi tak koi online payment nahi aaya.</td></tr>' : ''}
    </tbody>
  </table>
</div>
`;
%>
<%- include('layout', {body, page, title, features, query: locals.query}) %>
