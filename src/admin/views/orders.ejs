<%
const page = 'orders';
const title = 'Orders';

function statusBadge(s) {
  const map = {waiting:'warning',confirmed:'confirmed',preparing:'preparing',ready:'ready',delivered:'delivered',cancelled:'cancelled'};
  return `<span class="badge badge-${s}">${s.charAt(0).toUpperCase()+s.slice(1)}</span>`;
}
function payBadge(s) {
  const m = {paid:'paid',cod_pending:'cod',pending:'pending'};
  return `<span class="badge badge-${m[s]||'pending'}">${s.replace('_',' ')}</span>`;
}
%>
<%
const body = `
<div class="page-header">
  <h1>📦 Orders</h1>
  <div id="statsBar" style="font-size:13px;color:#6b7280"></div>
</div>

<div class="stats-grid">
  <div class="stat-card"><div class="label">Today Orders</div><div class="value" id="s-today">${stats.today_orders||0}</div></div>
  <div class="stat-card"><div class="label">Pending</div><div class="value" id="s-pending" style="color:var(--amber)">${stats.pending||0}</div></div>
  <div class="stat-card"><div class="label">Today Revenue</div><div class="value" id="s-trev">₹${Number(stats.today_revenue||0).toFixed(0)}</div></div>
  <div class="stat-card"><div class="label">Total Revenue</div><div class="value" id="s-rev">₹${Number(stats.total_revenue||0).toFixed(0)}</div></div>
</div>

<div class="tabs">
  <a href="/admin?filter=today" class="tab ${filter==='today'?'active':''}">🗓️ Aaj</a>
  <a href="/admin?filter=pending" class="tab ${filter==='pending'?'active':''}">⏳ Pending</a>
  <a href="/admin?filter=cod" class="tab ${filter==='cod'?'active':''}">💵 COD</a>
  <a href="/admin?filter=paid" class="tab ${filter==='paid'?'active':''}">✅ Paid</a>
  <a href="/admin?filter=all" class="tab ${filter==='all'?'active':''}">📋 All</a>
</div>

<form class="search-box" method="GET">
  <input name="search" value="${search||''}" placeholder="Search order # or customer name..." onchange="this.form.submit()">
  <input type="hidden" name="filter" value="${filter}">
</form>

<div class="card" style="padding:0;overflow-x:auto">
<table>
<thead>
  <tr>
    <th>Order #</th>
    <th>Customer</th>
    <th>Items</th>
    <th>Total</th>
    <th>Payment</th>
    <th>Status</th>
    ${features.delivery_boys ? '<th>Delivery Boy</th>' : ''}
    <th>Time</th>
    <th>Actions</th>
  </tr>
</thead>
<tbody>
${orders.map(o => {
  const items = typeof o.items === 'string' ? JSON.parse(o.items) : o.items;
  const itemList = items.map(i => `${i.name} x${i.qty}`).join('<br>');
  const mapsBtn = o.customer_lat ? `<button class="btn btn-ghost btn-sm" onclick="showMap(${o.customer_lat},${o.customer_lng})" title="Map">🗺️</button>` : '';
  const codBtn = o.payment_method==='cod' && o.payment_status!=='paid' ? `<button class="btn btn-sm" style="background:var(--green);color:#fff" onclick="markPaid(${o.id},this)">💰 Cash Mila</button>` : '';
  const editBtn = `<button class="btn btn-ghost btn-sm" onclick="openEdit(${o.id},'${o.items.replace(/'/g,"\\'")}')">✏️</button>`;
  const dbSelect = features.delivery_boys ? `
    <select class="form-control" style="font-size:12px;padding:4px 8px" onchange="assignDelivery(${o.id},this.value,this)">
      <option value="">-- Assign --</option>
      ${deliveryBoys.map(b=>`<option value="${b.id}" ${o.delivery_boy_id==b.id?'selected':''}>${b.name}</option>`).join('')}
    </select>` : '';

  const isFinal = o.order_status === 'delivered' || o.order_status === 'cancelled';
  const statusColors = {waiting:'#f59e0b',confirmed:'#3b82f6',preparing:'#8b5cf6',ready:'#22c55e',delivered:'#10b981',cancelled:'#ef4444'};
  const statusSelect = isFinal
    ? `<span class="badge badge-${o.order_status}" style="font-size:12px;padding:6px 12px">${o.order_status.charAt(0).toUpperCase()+o.order_status.slice(1)}</span>`
    : `<select class="form-control" style="font-size:12px;padding:4px 8px;border-color:${statusColors[o.order_status]||'#d1d5db'};font-weight:600" onchange="updateStatus(${o.id},this.value,this)">
      ${['waiting','confirmed','preparing','ready','delivered','cancelled'].map(s=>`<option value="${s}" ${o.order_status===s?'selected':''}>${s.charAt(0).toUpperCase()+s.slice(1)}</option>`).join('')}
    </select>`;

  return `<tr>
    <td><strong>#${o.order_number}</strong><br><span style="font-size:11px;color:#6b7280">${o.payment_method==='cod'?'💵 COD':'💳 Online'}</span></td>
    <td><strong>${o.customer_name||'-'}</strong><br><span style="font-size:11px;color:#6b7280">${o.customer_phone||o.phone}</span>${o.delivery_address?`<br><span style="font-size:11px;color:#6b7280">${o.delivery_address.substring(0,40)}</span>`:''}</td>
    <td style="font-size:12px">${itemList}</td>
    <td><strong>₹${o.total}</strong><br>${payBadge(o.payment_status)}</td>
    <td>${o.payment_method==='cod'?'<span class="badge badge-cod">COD</span>':'<span class="badge badge-paid">Online</span>'}</td>
    <td>${statusSelect}</td>
    ${features.delivery_boys ? `<td>${dbSelect}</td>` : ''}
    <td style="font-size:11px;color:#6b7280">${new Date(o.created_at).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'})}</td>
    <td>${codBtn} ${editBtn} ${mapsBtn}</td>
  </tr>`;
}).join('')}
${orders.length===0?'<tr><td colspan="9" style="text-align:center;padding:32px;color:#6b7280">No orders found</td></tr>':''}
</tbody>
</table>
</div>

<!-- Map Modal -->
<div class="modal-overlay" id="mapModal">
  <div class="modal" style="max-width:600px">
    <button class="close" onclick="document.getElementById('mapModal').classList.remove('open')">×</button>
    <h2>🗺️ Customer Location</h2>
    <iframe id="mapFrame" width="100%" height="400" style="border:0;border-radius:8px;margin-top:12px" allowfullscreen></iframe>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal-overlay" id="editModal">
  <div class="modal">
    <button class="close" onclick="document.getElementById('editModal').classList.remove('open')">×</button>
    <h2>✏️ Edit Order Items</h2>
    <div id="editItems"></div>
    <button class="btn btn-primary" onclick="saveEdit()" style="margin-top:16px;width:100%">Save Changes</button>
  </div>
</div>

<!-- New Order Alert -->
<div id="newOrderOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:9998"></div>
<div id="newOrderAlert" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#fff;border:3px solid var(--green);border-radius:20px;padding:32px 36px;box-shadow:0 12px 50px rgba(0,0,0,.35);z-index:9999;min-width:340px;text-align:center">
  <div style="font-size:48px;margin-bottom:10px;animation:ring 0.5s infinite alternate">🔔</div>
  <div style="font-weight:700;font-size:20px;margin-bottom:6px;color:#111">Naya Order Aaya!</div>
  <div id="newOrderText" style="font-size:14px;color:#374151;margin-bottom:22px;line-height:1.6;background:#f9fafb;padding:12px;border-radius:10px"></div>
  <div style="display:flex;gap:12px;justify-content:center">
    <button class="btn btn-primary" onclick="acceptOrder()" style="padding:11px 28px;font-size:14px;border-radius:10px">✅ Accept Karo</button>
    <button class="btn btn-danger" onclick="declineAlert()" style="padding:11px 28px;font-size:14px;border-radius:10px">⏰ Baad Mein</button>
  </div>
</div>
<style>
@keyframes ring { from{transform:translate(-50%,-50%) scale(1)} to{transform:translate(-50%,-50%) scale(1.02)} }
</style>
`;
%>
<%- include('layout', {body, page, title, features}) %>

<script>
let lastOrderId = 0;
let currentEditOrderId = null;
let currentEditItems = [];

// Get initial last order id
fetch('/admin/api/latest-order-id').then(r=>r.json()).then(d=>{ lastOrderId = d.id; });

async function updateStatus(orderId, status, sel) {
  sel.disabled = true;
  const r = await fetch('/admin/api/update-status',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({order_id:orderId,status})});
  const d = await r.json();
  sel.disabled = false;
  if(!d.success) alert('Error updating status');
}

async function markPaid(orderId, btn) {
  btn.disabled = true;
  await fetch('/admin/api/mark-paid',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({order_id:orderId})});
  btn.textContent = '✅ Paid';
  btn.style.background = '#6b7280';
}

async function assignDelivery(orderId, boyId, sel) {
  if(!boyId) return;
  sel.disabled = true;
  const r = await fetch('/admin/api/assign-delivery',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({order_id:orderId,delivery_boy_id:boyId})});
  const d = await r.json();
  sel.disabled = false;
  if(d.success) sel.style.borderColor='var(--green)';
  else alert('Error assigning delivery');
}

function showMap(lat, lng) {
  document.getElementById('mapFrame').src = `https://maps.google.com/maps?q=${lat},${lng}&output=embed`;
  document.getElementById('mapModal').classList.add('open');
}

function openEdit(orderId, itemsJson) {
  currentEditOrderId = orderId;
  currentEditItems = JSON.parse(itemsJson);
  const container = document.getElementById('editItems');
  container.innerHTML = currentEditItems.map((item,i) => `
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;padding:10px;background:#f9fafb;border-radius:8px">
      <div style="flex:1;font-size:14px;font-weight:500">${item.name}<br><span style="font-size:12px;color:#6b7280">₹${item.price} each</span></div>
      <input type="number" min="0" value="${item.qty}" style="width:70px;padding:6px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;text-align:center" onchange="currentEditItems[${i}].qty=parseInt(this.value)||0">
    </div>
  `).join('');
  document.getElementById('editModal').classList.add('open');
}

async function saveEdit() {
  const items = currentEditItems.filter(i => i.qty > 0);
  const r = await fetch('/admin/api/edit-order',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({order_id:currentEditOrderId,items:JSON.stringify(items)})});
  const d = await r.json();
  if(d.success) { document.getElementById('editModal').classList.remove('open'); location.reload(); }
  else alert('Error saving order');
}

// Police siren sound — loud wee-woo
let beepInterval = null;
function playBeep() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const gain = ctx.createGain();
    gain.gain.setValueAtTime(1.0, ctx.currentTime);
    gain.connect(ctx.destination);
    // Wee-woo x2
    for(let i=0; i<2; i++) {
      const osc = ctx.createOscillator();
      osc.connect(gain);
      osc.type = 'sawtooth';
      const t = ctx.currentTime + i * 0.9;
      osc.frequency.setValueAtTime(600, t);
      osc.frequency.linearRampToValueAtTime(1200, t + 0.4);
      osc.frequency.linearRampToValueAtTime(600, t + 0.8);
      osc.start(t);
      osc.stop(t + 0.85);
    }
  } catch(e){}
}

function showAlert(orders) {
  document.getElementById('newOrderText').innerHTML = orders.map(o=>
    `<strong>#${o.order_number}</strong> — ${o.customer_name||'Customer'} — <strong>₹${o.total}</strong>`
  ).join('<br>');
  document.getElementById('newOrderAlert').style.display = 'block';
  document.getElementById('newOrderOverlay').style.display = 'block';
  document.title = '🔔 NEW ORDER! — Admin';
  playBeep();
  if(beepInterval) clearInterval(beepInterval);
  beepInterval = setInterval(playBeep, 4000);

  // System notification — works even when browser minimized/other tab
  if('Notification' in window) {
    if(Notification.permission === 'granted') {
      const n = new Notification('🔔 Naya Order Aaya!', {
        body: orders.map(o=>`#${o.order_number} — Rs.${o.total} — ${o.customer_name||''}`).join('\n'),
        icon: '/favicon.ico',
        requireInteraction: true,  // stays until clicked
        tag: 'new-order'
      });
      n.onclick = () => { window.focus(); n.close(); acceptOrder(); };
    } else if(Notification.permission !== 'denied') {
      Notification.requestPermission().then(p => {
        if(p === 'granted') showAlert(orders);
      });
    }
  }

  // BroadcastChannel — notify ALL open tabs
  try {
    const bc = new BroadcastChannel('foodbot-orders');
    bc.postMessage({ type: 'new-order', orders });
  } catch(e){}
}

// Listen for alerts from other tabs
try {
  const bc = new BroadcastChannel('foodbot-orders');
  bc.onmessage = (e) => {
    if(e.data.type === 'new-order') showAlert(e.data.orders);
  };
} catch(e){}

function acceptOrder() {
  if(beepInterval){ clearInterval(beepInterval); beepInterval=null; }
  document.getElementById('newOrderAlert').style.display='none';
  document.getElementById('newOrderOverlay').style.display='none';
  document.title = 'Orders — Admin';
  location.reload();
}

function declineAlert() {
  if(beepInterval){ clearInterval(beepInterval); beepInterval=null; }
  document.getElementById('newOrderAlert').style.display='none';
  document.getElementById('newOrderOverlay').style.display='none';
}

// Polling handled by startPolling() below

// Stats refresh every 15s
setInterval(async () => {
  try {
    const d = await fetch('/admin/api/stats').then(r=>r.json());
    document.getElementById('s-today').textContent = d.today_orders||0;
    document.getElementById('s-pending').textContent = d.pending||0;
    document.getElementById('s-trev').textContent = '₹'+(Number(d.today_revenue||0).toFixed(0));
    document.getElementById('s-rev').textContent = '₹'+(Number(d.total_revenue||0).toFixed(0));
  } catch(e){}
}, 15000);

// Auto page refresh every 60s (jab alert na ho)
setInterval(()=>{
  if(document.getElementById('newOrderAlert').style.display==='none') location.reload();
}, 60000);

// ===== SERVICE WORKER SETUP =====
let swReg = null;

async function initServiceWorker() {
  if (!('serviceWorker' in navigator)) return;
  try {
    swReg = await navigator.serviceWorker.register('/sw.js');
    console.log('SW registered');
  } catch(e) {
    console.log('SW failed:', e);
  }
}

// Notification permission request — aggressive
async function requestNotifPermission() {
  if (!('Notification' in window)) return;
  if (Notification.permission === 'default') {
    const perm = await Notification.requestPermission();
    if (perm === 'granted') {
      new Notification('Notifications ON!', {
        body: 'You will now get alerts for new orders even on other tabs.',
        icon: '/icon-192.png'
      });
    }
  }
}

// Init on load
initServiceWorker();
requestNotifPermission();

// ===== VISIBILITY CHANGE — Fast polling when tab hidden =====
let pollInterval = null;
function startPolling(fast) {
  if (pollInterval) clearInterval(pollInterval);
  pollInterval = setInterval(async () => {
    try {
      const orders = await fetch('/admin/api/new-orders?since=' + lastOrderId).then(r => r.json());
      if (orders.length) {
        lastOrderId = orders[0].id;
        showAlert(orders);
        // Notify via Service Worker (works when browser minimized)
        if (swReg && swReg.active) {
          swReg.active.postMessage({ type: 'NEW_ORDER', orders });
        }
      }
    } catch(e) {}
  }, fast ? 5000 : 8000);
}

// Start polling
startPolling(false);

// When user leaves tab — keep polling
document.addEventListener('visibilitychange', () => {
  startPolling(document.hidden); // faster when hidden
});
</script>
