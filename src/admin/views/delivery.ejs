<%
const page = 'delivery';
const title = 'Delivery Boys';
const body = `
<div class="page-header">
  <h1>🛵 Delivery Boys</h1>
  <button class="btn btn-primary" onclick="document.getElementById('addModal').classList.add('open')">+ Add Delivery Boy</button>
</div>
<div class="card" style="padding:0">
<table>
  <thead><tr><th>Name</th><th>WhatsApp Number</th><th>Status</th><th>Actions</th></tr></thead>
  <tbody>
  ${boys.map(b => `<tr>
    <td><strong>${b.name}</strong></td>
    <td>+${b.whatsapp_number}</td>
    <td><span class="badge ${b.is_active?'badge-ready':'badge-cancelled'}">${b.is_active?'Active':'Inactive'}</span></td>
    <td>
      <button class="btn btn-ghost btn-sm" onclick="openEdit(${b.id},'${b.name.replace(/'/g,"\\'")}','${b.whatsapp_number}')">✏️ Edit</button>
      <button class="btn btn-ghost btn-sm" onclick="toggle(${b.id})">${b.is_active?'🔴 Disable':'🟢 Enable'}</button>
      <button class="btn btn-danger btn-sm" onclick="del(${b.id})">🗑️</button>
    </td>
  </tr>`).join('')}
  ${boys.length===0?'<tr><td colspan="4" style="text-align:center;padding:32px;color:#6b7280">No delivery boys added yet.</td></tr>':''}
  </tbody>
</table>
</div>

<div class="card" style="background:#fef3c7;border-color:#f59e0b">
  <strong>📱 WhatsApp Number Format:</strong><br>
  <span style="font-size:13px;color:#374151">Enter without + sign, with country code. Example: <strong>919876543210</strong> for +91 98765 43210</span>
</div>

<!-- Add Modal -->
<div class="modal-overlay" id="addModal">
  <div class="modal">
    <button class="close" onclick="document.getElementById('addModal').classList.remove('open')">×</button>
    <h2>Add Delivery Boy</h2>
    <form method="POST" action="/admin/delivery">
      <input type="hidden" name="action" value="add">
      <div class="form-group"><label>Name</label><input name="name" class="form-control" required placeholder="Full name"></div>
      <div class="form-group"><label>WhatsApp Number</label><input name="whatsapp_number" class="form-control" required placeholder="919876543210"></div>
      <button type="submit" class="btn btn-primary" style="width:100%">Add</button>
    </form>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal-overlay" id="editModal">
  <div class="modal">
    <button class="close" onclick="document.getElementById('editModal').classList.remove('open')">×</button>
    <h2>Edit Delivery Boy</h2>
    <form method="POST" action="/admin/delivery">
      <input type="hidden" name="action" value="edit">
      <input type="hidden" name="id" id="editId">
      <div class="form-group"><label>Name</label><input name="name" id="editName" class="form-control" required></div>
      <div class="form-group"><label>WhatsApp Number</label><input name="whatsapp_number" id="editPhone" class="form-control" required></div>
      <button type="submit" class="btn btn-primary" style="width:100%">Save</button>
    </form>
  </div>
</div>

<script>
function openEdit(id, name, phone) {
  document.getElementById('editId').value = id;
  document.getElementById('editName').value = name;
  document.getElementById('editPhone').value = phone;
  document.getElementById('editModal').classList.add('open');
}
function toggle(id) {
  const f = document.createElement('form'); f.method='POST'; f.action='/admin/delivery';
  f.innerHTML='<input name="action" value="toggle"><input name="id" value="'+id+'">'; document.body.appendChild(f); f.submit();
}
function del(id) {
  if(!confirm('Delete this delivery boy?')) return;
  const f = document.createElement('form'); f.method='POST'; f.action='/admin/delivery';
  f.innerHTML='<input name="action" value="delete"><input name="id" value="'+id+'">'; document.body.appendChild(f); f.submit();
}
</script>
`;
%>
<%- include('layout', {body, page, title, features}) %>
