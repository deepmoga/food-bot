<%
const page = 'settings';
const title = 'Settings';
function s(key) { return settings[key] || ''; }
const body = `
<div class="page-header">
  <h1>⚙️ Settings</h1>
</div>
${locals.query && locals.query.saved ? '<div class="alert alert-success">✅ Settings saved successfully!</div>' : ''}
<form method="POST" action="/admin/settings">
  <div class="card" style="border:2px solid var(--green);display:flex;align-items:center;gap:24px;flex-wrap:wrap">
    <div style="flex:1;min-width:250px">
      <h3 style="margin-bottom:8px;font-size:16px">🟢 WhatsApp Ordering QR Code</h3>
      <p style="font-size:13px;color:#4b5563;margin-bottom:12px">
        Apne customers ke liye QR code download karein. Ise print karke table counters ya menu cards par lagayein taaki customers scan karke WhatsApp par order kar sakein!
      </p>
      ${s('restaurant_phone') ? (
        '<div style="margin-bottom:12px;word-break:break-all">' +
          '<strong style="font-size:12px">WhatsApp Link:</strong> <a href="https://wa.me/' + s('restaurant_phone') + '?text=hi" target="_blank" style="color:var(--blue);text-decoration:none">https://wa.me/' + s('restaurant_phone') + '?text=hi</a>' +
        '</div>' +
        '<button type="button" class="btn btn-primary" onclick="downloadQRCode(\'https://wa.me/' + s('restaurant_phone') + '?text=hi\', this)">' +
          '📥 Download QR Code Image' +
        '</button>'
      ) : (
        '<div class="alert alert-error" style="margin-bottom:0;padding:8px 12px">' +
          '⚠️ Please set and save your <strong>WhatsApp Number</strong> under Restaurant Info first to generate the QR Code.' +
        '</div>'
      )}
    </div>
    ${s('restaurant_phone') ? (
      '<div style="text-align:center;background:#fff;padding:12px;border:1px solid #e5e7eb;border-radius:8px">' +
        '<img id="qr-image" src="https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' + encodeURIComponent('https://wa.me/' + s('restaurant_phone') + '?text=hi') + '" alt="WhatsApp QR Code" style="width:150px;height:150px;display:block" />' +
      '</div>'
    ) : ''}
  </div>

  <div class="card">
    <h3 style="margin-bottom:16px;font-size:16px">🏪 Restaurant Info</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      <div class="form-group"><label>Restaurant Name</label><input name="restaurant_name" class="form-control" value="${s('restaurant_name')}"></div>
      <div class="form-group"><label>WhatsApp Number (with country code)</label><input name="restaurant_phone" class="form-control" value="${s('restaurant_phone')}" placeholder="919876543210"></div>
      <div class="form-group" style="grid-column:1/-1"><label>Address</label><input name="restaurant_address" class="form-control" value="${s('restaurant_address')}"></div>
      <div class="form-group">
        <label>Restaurant Latitude <span style="font-size:11px;color:#6b7280">(Google Maps se lo)</span></label>
        <input name="restaurant_lat" class="form-control" value="${s('restaurant_lat')}" placeholder="30.9010">
      </div>
      <div class="form-group">
        <label>Restaurant Longitude <span style="font-size:11px;color:#6b7280">(Google Maps se lo)</span></label>
        <input name="restaurant_lng" class="form-control" value="${s('restaurant_lng')}" placeholder="75.8573">
      </div>
      <div class="form-group" style="grid-column:1/-1">
        <a href="https://www.google.com/maps" target="_blank" style="font-size:12px;color:#3b82f6">
          🗺️ Google Maps khoolo → apni restaurant dhundho → URL se lat/lng copy karo
        </a>
      </div>
      <div class="form-group"><label>Tagline</label><input name="restaurant_tagline" class="form-control" value="${s('restaurant_tagline')}"></div>
      <div class="form-group"><label>Logo URL</label><input name="restaurant_logo_url" class="form-control" value="${s('restaurant_logo_url')}"></div>
      <div class="form-group"><label>GSTIN</label><input name="restaurant_gstin" class="form-control" value="${s('restaurant_gstin')}"></div>
      <div class="form-group" style="grid-column:1/-1"><label>Bill Footer Text</label><input name="bill_footer_text" class="form-control" value="${s('bill_footer_text')}"></div>
    </div>
  </div>

  <div class="card" style="border:2px solid var(--purple)">
    <h3 style="margin-bottom:4px;font-size:16px">🏷️ Automatic Discounts (Store-Wide & Happy Hour)</h3>
    <p style="font-size:12px;color:#6b7280;margin-bottom:16px">
      Bina coupon code ke customers nu automatic milan wale discounts. (Happy Hour active hon te Store-wide discount overrule ho jayega).
    </p>
    
    <h4 style="font-size:14px;font-weight:600;margin-bottom:10px;color:var(--purple)">🏪 Store-Wide Discount</h4>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:20px;border-bottom:1px solid #e5e7eb;padding-bottom:16px">
      <div class="form-group">
        <label>Enable Store-Wide Discount</label>
        <select name="store_discount_enabled" class="form-control">
          <option value="1" ${s('store_discount_enabled')==='1'?'selected':''}>Yes</option>
          <option value="0" ${s('store_discount_enabled')!=='1'?'selected':''}>No</option>
        </select>
      </div>
      <div class="form-group">
        <label>Discount Type</label>
        <select name="store_discount_type" class="form-control">
          <option value="percent" ${s('store_discount_type')==='percent'?'selected':''}>Percentage (%)</option>
          <option value="flat" ${s('store_discount_type')==='flat'?'selected':''}>Flat Amount (₹)</option>
        </select>
      </div>
      <div class="form-group">
        <label>Discount Value</label>
        <input name="store_discount_value" type="number" step="0.01" min="0" class="form-control" value="${s('store_discount_value')||'0'}">
      </div>
    </div>

    <h4 style="font-size:14px;font-weight:600;margin-bottom:10px;color:var(--purple)">⚡ Happy Hour Discount</h4>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px">
      <div class="form-group">
        <label>Enable Happy Hour</label>
        <select name="happy_hour_enabled" class="form-control">
          <option value="1" ${s('happy_hour_enabled')==='1'?'selected':''}>Yes</option>
          <option value="0" ${s('happy_hour_enabled')!=='1'?'selected':''}>No</option>
        </select>
      </div>
      <div class="form-group">
        <label>Discount Type</label>
        <select name="happy_hour_type" class="form-control">
          <option value="percent" ${s('happy_hour_type')==='percent'?'selected':''}>Percentage (%)</option>
          <option value="flat" ${s('happy_hour_type')==='flat'?'selected':''}>Flat Amount (₹)</option>
        </select>
      </div>
      <div class="form-group">
        <label>Discount Value</label>
        <input name="happy_hour_value" type="number" step="0.01" min="0" class="form-control" value="${s('happy_hour_value')||'0'}">
      </div>
      <div class="form-group">
        <label>Start Time (HH:MM)</label>
        <input name="happy_hour_start" type="time" class="form-control" value="${s('happy_hour_start')||'16:00'}">
      </div>
      <div class="form-group">
        <label>End Time (HH:MM)</label>
        <input name="happy_hour_end" type="time" class="form-control" value="${s('happy_hour_end')||'19:00'}">
      </div>
    </div>
  </div>

  <div class="card" style="border:2px solid #3b82f6">
    <h3 style="margin-bottom:4px;font-size:16px">📍 Delivery Zone (Kitne km tak delivery hogi)</h3>
    <p style="font-size:12px;color:#6b7280;margin-bottom:16px">Customer jab live location share kare toh agar is radius se bahar hai toh sorry message jayega.</p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      <div class="form-group">
        <label>Max Delivery Radius (km) <span style="color:#e53935">*</span></label>
        <input name="service_radius_km" type="number" step="0.1" min="0.5" class="form-control" value="${s('service_radius_km')||'5'}" placeholder="5">
        <span style="font-size:11px;color:#6b7280">Example: 5 = 5km tak delivery hogi</span>
      </div>
      <div class="form-group"><label>Delivery Charge (₹)</label><input name="delivery_charge" type="number" step="0.01" class="form-control" value="${s('delivery_charge')}"></div>
      <div class="form-group"><label>Free Delivery Above (₹)</label><input name="free_delivery_above" type="number" step="0.01" class="form-control" value="${s('free_delivery_above')}"></div>
      <div class="form-group"><label>Min Order Amount (₹)</label><input name="min_order_amount" type="number" step="0.01" class="form-control" value="${s('min_order_amount')}"></div>
      <div class="form-group"><label>Estimated Time</label><input name="estimated_time" class="form-control" value="${s('estimated_time')}" placeholder="30-45"></div>
    </div>
  </div>

  <div class="card">
    <h3 style="margin-bottom:16px;font-size:16px">💳 Payment</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      <div class="form-group"><label>COD Enabled</label>
        <select name="cod_enabled" class="form-control"><option value="1" ${s('cod_enabled')==='1'?'selected':''}>Yes</option><option value="0" ${s('cod_enabled')!=='1'?'selected':''}>No</option></select>
      </div>
      <div class="form-group"><label>Online Payment Enabled</label>
        <select name="online_payment_enabled" class="form-control"><option value="1" ${s('online_payment_enabled')==='1'?'selected':''}>Yes</option><option value="0" ${s('online_payment_enabled')!=='1'?'selected':''}>No</option></select>
      </div>
      <div class="form-group"><label>Razorpay Key ID</label><input name="razorpay_key_id" class="form-control" value="${s('razorpay_key_id')}"></div>
      <div class="form-group"><label>Razorpay Key Secret</label><input name="razorpay_key_secret" type="password" class="form-control" value="${s('razorpay_key_secret')}"></div>
      <div class="form-group" style="grid-column:1/-1"><label>Razorpay Webhook Secret</label><input name="razorpay_webhook_secret" class="form-control" value="${s('razorpay_webhook_secret')}"></div>
    </div>
  </div>

  <div class="card">
    <h3 style="margin-bottom:16px;font-size:16px">📊 GST</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      <div class="form-group"><label>GST Enabled</label>
        <select name="gst_enabled" class="form-control"><option value="1" ${s('gst_enabled')==='1'?'selected':''}>Yes</option><option value="0" ${s('gst_enabled')!=='1'?'selected':''}>No</option></select>
      </div>
      <div class="form-group"><label>GST Percent</label><input name="gst_percent" type="number" step="0.1" class="form-control" value="${s('gst_percent')}"></div>
      <div class="form-group"><label>GST Included in Price</label>
        <select name="gst_included" class="form-control"><option value="1" ${s('gst_included')==='1'?'selected':''}>Yes (inclusive)</option><option value="0" ${s('gst_included')!=='1'?'selected':''}>No (add on top)</option></select>
      </div>
    </div>
  </div>

  <div class="card" style="border:2px solid var(--orange)">
    <h3 style="margin-bottom:4px;font-size:16px;color:var(--orange)">👨‍🍳 Kitchen Screen (KDS)</h3>
    <p style="font-size:12px;color:#6b7280;margin-bottom:16px">
      Kitchen staff display screen configuration. Staff can view active orders, accept them, and mark them as ready.
    </p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:end">
      <div class="form-group" style="margin-bottom:0">
        <label>Kitchen Passcode (4-digit code)</label>
        <input name="kitchen_passcode" class="form-control" value="${s('kitchen_passcode') || '1234'}" placeholder="e.g. 1234" maxlength="10">
      </div>
      <div class="form-group" style="margin-bottom:0">
        ${s('kitchen_passcode') ? (
          `<button type="button" class="btn btn-ghost" style="width:100%;padding:10px;border:1px solid #d1d5db" onclick="copyKitchenLink(this)">` +
            `🔗 Copy Kitchen Screen Link` +
          `</button>`
        ) : (
          `<span style="font-size:12px;color:#ef4444">⚠️ Please save settings first to generate link.</span>`
        )}
      </div>
    </div>
  </div>

  <div class="card" style="border:2px solid #25d366">
    <h3 style="margin-bottom:4px;font-size:16px">📱 WhatsApp API</h3>
    <p style="font-size:12px;color:#6b7280;margin-bottom:16px">
      Phone Number ID tumhare admin ne provide kiya hoga. Token platform level pe set hai.
    </p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      <div class="form-group"><label>Phone Number ID</label><input name="whatsapp_phone_id" class="form-control" value="${s('whatsapp_phone_id')}" placeholder="Platform admin se lo"></div>
      <div class="form-group"><label>Verify Token</label><input name="verify_token" class="form-control" value="${s('verify_token')}"></div>
    </div>
    <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:10px 12px;font-size:12px;color:#166534;margin-top:4px">
      ✅ WhatsApp Token platform level pe set hai — tumhe kuch karne ki zaroorat nahi
    </div>
  </div>

  <div class="card">
    <h3 style="margin-bottom:16px;font-size:16px">🔗 Links</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      <div class="form-group"><label>Base URL</label><input name="base_url" class="form-control" value="${s('base_url')}" placeholder="https://yourdomain.com"></div>
      <div class="form-group"><label>Google Review Link</label><input name="google_review_link" class="form-control" value="${s('google_review_link')}"></div>
      <div class="form-group"><label>Review After (minutes)</label><input name="review_after_minutes" type="number" class="form-control" value="${s('review_after_minutes')}"></div>
      <div class="form-group"><label>Store Timezone</label><input name="store_timezone" class="form-control" value="${s('store_timezone')}" placeholder="Asia/Kolkata"></div>
    </div>
  </div>

  <button type="submit" class="btn btn-primary" style="width:100%;padding:12px;font-size:15px">💾 Save All Settings</button>
</form>
<script>
async function downloadQRCode(waLink, btn) {
  const qrUrl = "https://api.qrserver.com/v1/create-qr-code/?size=500x500&data=" + encodeURIComponent(waLink);
  const oldText = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = "⏳ Generating QR Poster...";
  
  try {
    const restNameInput = document.querySelector('input[name="restaurant_name"]');
    const taglineInput = document.querySelector('input[name="restaurant_tagline"]');
    const restName = (restNameInput ? restNameInput.value.trim() : "") || "Our Restaurant";
    const tagline = (taglineInput ? taglineInput.value.trim() : "") || "Delicious Food, Fast Delivery";

    const canvas = document.createElement('canvas');
    canvas.width = 600;
    canvas.height = 850;
    const ctx = canvas.getContext('2d');
    
    const qrImg = new Image();
    qrImg.crossOrigin = "anonymous";
    
    const qrLoaded = new Promise((resolve, reject) => {
      qrImg.onload = resolve;
      qrImg.onerror = reject;
    });
    qrImg.src = qrUrl;
    await qrLoaded;
    
    // Background
    ctx.fillStyle = "#ffffff";
    ctx.fillRect(0, 0, 600, 850);
    
    // Outer Border (WhatsApp Green)
    ctx.lineWidth = 16;
    ctx.strokeStyle = "#25D366";
    ctx.lineJoin = "round";
    ctx.strokeRect(8, 8, 600 - 16, 850 - 16);
    
    // Inner Border
    ctx.lineWidth = 2;
    ctx.strokeStyle = "#e2e8f0";
    ctx.strokeRect(24, 24, 600 - 48, 850 - 48);
    
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    
    // Restaurant Name
    ctx.fillStyle = "#1e293b";
    ctx.font = "bold 38px 'Segoe UI', -apple-system, sans-serif";
    ctx.fillText(restName, 300, 90);
    
    // Tagline
    ctx.fillStyle = "#64748b";
    ctx.font = "italic 16px 'Segoe UI', -apple-system, sans-serif";
    ctx.fillText(tagline, 300, 135);
    
    // Divider
    ctx.beginPath();
    ctx.moveTo(150, 160);
    ctx.lineTo(450, 160);
    ctx.strokeStyle = "#cbd5e1";
    ctx.lineWidth = 1;
    ctx.stroke();
    
    // "SCAN FOR ORDER" Badge
    ctx.fillStyle = "#25D366";
    const px = 150, py = 190, pw = 300, ph = 48, pr = 24;
    ctx.beginPath();
    ctx.moveTo(px + pr, py);
    ctx.lineTo(px + pw - pr, py);
    ctx.quadraticCurveTo(px + pw, py, px + pw, py + pr);
    ctx.lineTo(px + pw, py + ph - pr);
    ctx.quadraticCurveTo(px + pw, py + ph, px + pw - pr, py + ph);
    ctx.lineTo(px + pr, py + ph);
    ctx.quadraticCurveTo(px, py + ph, px, py + ph - pr);
    ctx.lineTo(px, py + pr);
    ctx.quadraticCurveTo(px, py, px + pr, py);
    ctx.closePath();
    ctx.fill();
    
    ctx.fillStyle = "#ffffff";
    ctx.font = "bold 20px 'Segoe UI', -apple-system, sans-serif";
    ctx.fillText("💬 SCAN FOR ORDER", 300, 214);
    
    // QR Code Frame
    ctx.fillStyle = "#f8fafc";
    ctx.strokeStyle = "#e2e8f0";
    ctx.lineWidth = 2;
    const qx = 130, qy = 270, qw = 340, qh = 340, qr = 16;
    ctx.beginPath();
    ctx.moveTo(qx + qr, qy);
    ctx.lineTo(qx + qw - qr, qy);
    ctx.quadraticCurveTo(qx + qw, qy, qx + qw, qy + qr);
    ctx.lineTo(qx + qw, qy + qh - qr);
    ctx.quadraticCurveTo(qx + qw, qy + qh, qx + qw - qr, qy + qh);
    ctx.lineTo(qx + qr, qy + qh);
    ctx.quadraticCurveTo(qx, qy + qh, qx, qy + qh - qr);
    ctx.lineTo(qx, qy + qr);
    ctx.quadraticCurveTo(qx, qy, qx + qr, qy);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    
    // QR Code Image
    ctx.drawImage(qrImg, 150, 290, 300, 300);
    
    // Instructions
    ctx.fillStyle = "#475569";
    ctx.font = "600 15px 'Segoe UI', -apple-system, sans-serif";
    ctx.fillText("1. Open WhatsApp Camera | 2. Scan QR | 3. Send 'Hi'", 300, 650);
    
    ctx.fillStyle = "#64748b";
    ctx.font = "13px 'Segoe UI', -apple-system, sans-serif";
    ctx.fillText("No apps to download. Order in 2 minutes!", 300, 680);
    
    // Thank you text
    ctx.fillStyle = "#16a34a";
    ctx.font = "bold 24px 'Segoe UI', -apple-system, sans-serif";
    ctx.fillText("Thank you for ordering! 🙏", 300, 755);
    
    const dataUrl = canvas.toDataURL('image/png');
    const link = document.createElement('a');
    link.href = dataUrl;
    const cleanName = restName.replace(/[^a-z0-9]/gi, '_').toLowerCase();
    link.download = cleanName + '_whatsapp_qr.png';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    
  } catch (error) {
    console.error("QR Code template generation failed:", error);
    alert("Failed to generate custom QR template. Please try again.");
  } finally {
    btn.disabled = false;
    btn.innerHTML = oldText;
  }
}

function copyKitchenLink(btn) {
  const passcode = document.querySelector('input[name="kitchen_passcode"]').value.trim();
  const link = window.location.origin + '/kitchen?vendor_id=' + '<%= vendorId %>' + '&passcode=' + encodeURIComponent(passcode);
  navigator.clipboard.writeText(link).then(() => {
    const oldText = btn.innerHTML;
    btn.innerHTML = '📋 Link Copied!';
    setTimeout(() => { btn.innerHTML = oldText; }, 2000);
  }).catch(() => {
    alert('Failed to copy link. Manual link: ' + link);
  });
}
</script>
`;
%>
<%- include('layout', {body, page, title, features, query: locals.query}) %>
