<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Vendor Wallet — Super Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Plus Jakarta Sans',sans-serif;background:#f3f4f6;color:#111}
.top{background:#1a1a2e;color:#fff;padding:16px 24px;display:flex;align-items:center;justify-content:space-between}
.top h1{font-size:18px;font-weight:700}
.top a{color:#a5b4fc;text-decoration:none;font-size:13px;margin-left:16px}
.main{padding:24px;max-width:1100px;margin:0 auto}
.page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
.page-header h2{font-size:20px;font-weight:700}
.card{background:#fff;border-radius:12px;border:1px solid #e5e7eb;overflow:hidden;margin-bottom:20px}
.card-pad{padding:16px}
.stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:20px}
.stat-card{background:#fff;border-radius:12px;border:1px solid #e5e7eb;padding:16px}
.stat-card .label{font-size:12px;color:#6b7280;font-weight:500;margin-bottom:4px}
.stat-card .value{font-size:22px;font-weight:700}
.table-scroll{overflow-x:auto;max-width:100%}
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;padding:10px 16px;background:#f9fafb;border-bottom:2px solid #e5e7eb;font-size:11px;text-transform:uppercase;color:#374151;font-weight:600;white-space:nowrap}
td{padding:10px 16px;border-bottom:1px solid #f3f4f6;vertical-align:middle}
.badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}
.settled{background:#d1fae5;color:#065f46}.pending{background:#fff3cd;color:#7d4e00}
.btn{display:inline-flex;align-items:center;padding:6px 12px;border-radius:8px;border:none;font-family:inherit;font-size:12px;font-weight:600;cursor:pointer;text-decoration:none;gap:4px}
.btn-indigo{background:#6366f1;color:#fff}.btn-ghost{background:#f3f4f6;color:#374151}.btn-green{background:#1db954;color:#fff}
.filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}
.filters select,.filters input{padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-family:inherit;font-size:13px}
.alert{padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:16px}
.alert-success{background:#d1fae5;color:#065f46}
.section-title{font-size:14px;font-weight:700;margin-bottom:10px}
.settle-form{display:flex;gap:10px;flex-wrap:wrap;align-items:end}
.settle-form .form-group{display:flex;flex-direction:column;gap:4px}
.settle-form label{font-size:12px;font-weight:600;color:#374151}
.settle-form input{padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;font-family:inherit;font-size:13px}
</style>
</head>
<body>
<div class="top">
  <h1>👑 Super Admin</h1>
  <div><a href="/superadmin">Dashboard</a><a href="/superadmin/vendors">Vendors</a><a href="/superadmin/wallet">Wallet</a><a href="/superadmin/plans">Plans</a><a href="/superadmin/templates">Templates</a><a href="/superadmin/settings">Settings</a><a href="/superadmin/logout">Logout</a></div>
</div>
<div class="main">
  <div class="page-header">
    <h2>💰 Vendor Wallet (Platform Gateway)</h2>
  </div>

  <% if(locals.query && locals.query.success){ %><div class="alert alert-success">✅ Payment record saved!</div><% } %>

  <p style="font-size:12px;color:#6b7280;margin-bottom:16px">
    Yeh wo online payments hain jo vendors ke "FoodBot Gateway" mode customers se collect hue hain —
    paisa FoodBot ke Razorpay account mein aaya hai. Vendor ko jab bhi payout karo, neeche "Record Payment"
    form se amount daal do — pending balance khud-ba-khud update ho jayega (order-by-order settle karne ki zaroorat nahi).
  </p>

  <div class="stats-grid">
    <div class="stat-card"><div class="label">Total Received (Gross)</div><div class="value">₹<%= Number(totals.total_amount || 0).toLocaleString('en-IN') %></div></div>
    <div class="stat-card"><div class="label">Commission Deducted</div><div class="value" style="color:#6366f1">₹<%= Number(totals.total_commission || 0).toLocaleString('en-IN') %></div></div>
    <div class="stat-card"><div class="label">Net Payable to Vendor</div><div class="value">₹<%= Number(totals.total_net || 0).toLocaleString('en-IN') %></div></div>
  </div>
  <div class="stats-grid">
    <div class="stat-card"><div class="label">Pending Due</div><div class="value" style="color:#d97706">₹<%= Number(totals.pending_amount || 0).toLocaleString('en-IN') %></div></div>
    <div class="stat-card"><div class="label">Total Paid Out</div><div class="value" style="color:#16a34a">₹<%= Number(totals.settled_amount || 0).toLocaleString('en-IN') %></div></div>
  </div>

  <form method="GET" class="filters">
    <select name="vendor_id" onchange="this.form.submit()">
      <option value="">All Vendors</option>
      <% vendors.forEach(v => { %>
        <option value="<%= v.id %>" <%= String(query.vendor_id)===String(v.id)?'selected':'' %>><%= v.name %></option>
      <% }) %>
    </select>
    <input type="date" name="from" value="<%= query.from||'' %>" placeholder="From">
    <input type="date" name="to" value="<%= query.to||'' %>" placeholder="To">
    <button type="submit" class="btn btn-indigo">Filter</button>
  </form>

  <% if(query.vendor_id){ %>
  <div class="card card-pad">
    <div class="section-title">💸 Record Payment to Vendor</div>
    <form method="POST" action="/superadmin/wallet/settle-payment" class="settle-form">
      <input type="hidden" name="vendor_id" value="<%= query.vendor_id %>">
      <div class="form-group">
        <label>Amount (₹)</label>
        <input type="number" name="amount" step="0.01" min="0.01" required placeholder="e.g. 5000" style="width:160px">
      </div>
      <div class="form-group" style="flex:1;min-width:200px">
        <label>Note (optional)</label>
        <input type="text" name="note" placeholder="e.g. UPI transfer 12/06, partial payout">
      </div>
      <button type="submit" class="btn btn-green">✅ Record Payment</button>
    </form>
    <div style="font-size:11px;color:#6b7280;margin-top:8px">
      Aap koi bhi custom amount daal sakte ho — pura pending due ya partial. Pending Due automatically update ho jayega.
    </div>
  </div>
  <% } %>

  <div class="card">
    <div style="padding:14px 16px 0" class="section-title">📜 Payment History (Payouts to Vendors)</div>
    <div class="table-scroll">
    <table>
      <thead><tr><th>ID</th><th>Vendor</th><th>Amount</th><th>Note</th><th>Date</th></tr></thead>
      <tbody>
      <% settlements.forEach(s => { %>
        <tr>
          <td>#<%= s.id %></td>
          <td><%= s.vendor_name %></td>
          <td>₹<%= Number(s.amount).toLocaleString('en-IN') %></td>
          <td style="color:#6b7280"><%= s.note || '—' %></td>
          <td style="color:#6b7280;font-size:12px"><%= new Date(s.created_at).toLocaleString('en-IN') %></td>
        </tr>
      <% }) %>
      <% if(!settlements.length){ %>
        <tr><td colspan="5" style="text-align:center;padding:24px;color:#6b7280">No payouts recorded yet.</td></tr>
      <% } %>
      </tbody>
    </table>
    </div>
  </div>

  <div class="card">
    <div style="padding:14px 16px 0" class="section-title">🧾 Online Order Payments (Received)</div>
    <div class="table-scroll">
    <table>
      <thead><tr><th>ID</th><th>Vendor</th><th>Order #</th><th>Amount (Gross)</th><th>Commission</th><th>Net Payable</th><th>Date</th></tr></thead>
      <tbody>
      <% rows.forEach(r => { %>
        <tr>
          <td>#<%= r.id %></td>
          <td><%= r.vendor_name %></td>
          <td><%= r.order_number %></td>
          <td>₹<%= Number(r.amount).toLocaleString('en-IN') %></td>
          <td style="color:#6366f1">₹<%= Number(r.commission_amount || 0).toLocaleString('en-IN') %></td>
          <td style="font-weight:600">₹<%= Number(r.net_amount || r.amount).toLocaleString('en-IN') %></td>
          <td style="color:#6b7280;font-size:12px"><%= new Date(r.created_at).toLocaleString('en-IN') %></td>
        </tr>
      <% }) %>
      <% if(!rows.length){ %>
        <tr><td colspan="7" style="text-align:center;padding:24px;color:#6b7280">No transactions yet.</td></tr>
      <% } %>
      </tbody>
    </table>
    </div>
  </div>
</div>
</body>
</html>
