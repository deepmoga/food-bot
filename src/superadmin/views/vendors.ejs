<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Vendors — Super Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Plus Jakarta Sans',sans-serif;background:#f3f4f6;color:#111}
.top{background:#1a1a2e;color:#fff;padding:16px 24px;display:flex;align-items:center;justify-content:space-between}
.top h1{font-size:18px;font-weight:700}
.top a{color:#a5b4fc;text-decoration:none;font-size:13px;margin-left:16px}
.main{padding:24px;max-width:1100px;margin:0 auto}
.page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
.page-header h2{font-size:20px;font-weight:700}
.card{background:#fff;border-radius:12px;border:1px solid #e5e7eb;overflow:hidden;margin-bottom:20px}
.table-scroll{overflow-x:auto;max-width:100%}
table{width:100%;border-collapse:collapse;font-size:13px;min-width:1100px}
th{text-align:left;padding:10px 16px;background:#f9fafb;border-bottom:2px solid #e5e7eb;font-size:11px;text-transform:uppercase;color:#374151;font-weight:600}
td{padding:10px 16px;border-bottom:1px solid #f3f4f6;vertical-align:middle}
.badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}
.active{background:#d1fae5;color:#065f46}.inactive{background:#fee2e2;color:#991b1b}
.btn{display:inline-flex;align-items:center;padding:6px 12px;border-radius:8px;border:none;font-family:inherit;font-size:12px;font-weight:600;cursor:pointer;text-decoration:none;gap:4px}
.btn-indigo{background:#6366f1;color:#fff}.btn-ghost{background:#f3f4f6;color:#374151}.btn-red{background:#e53935;color:#fff}
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100;align-items:center;justify-content:center}
.modal-overlay.open{display:flex}
.modal{background:#fff;border-radius:16px;padding:24px;width:90%;max-width:440px}
.modal h2{font-size:18px;font-weight:700;margin-bottom:16px}
.form-group{margin-bottom:14px}
label{display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px}
input{width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;font-family:inherit;font-size:13px;outline:none}
input:focus{border-color:#6366f1}
.close{float:right;cursor:pointer;font-size:20px;color:#6b7280;background:none;border:none}
.alert{padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:16px}
.alert-success{background:#d1fae5;color:#065f46}.alert-error{background:#fee2e2;color:#991b1b}
</style>
</head>
<body>
<div class="top">
  <h1>👑 Super Admin</h1>
  <div><a href="/superadmin">Dashboard</a><a href="/superadmin/vendors">Vendors</a>
    <a href="/superadmin/wallet">Wallet</a><a href="/superadmin/plans">Plans</a><a href="/superadmin/templates">Templates</a><a href="/superadmin/settings">Settings</a><a href="/superadmin/logout">Logout</a></div>
</div>
<div class="main">
  <div class="page-header">
    <h2>🏪 Manage Vendors</h2>
    <button class="btn btn-indigo" onclick="document.getElementById('addModal').classList.add('open')">+ Add Vendor</button>
  </div>

  <% if(locals.query && locals.query.success){ %><div class="alert alert-success">✅ Done!</div><% } %>
  <% if(error){ %><div class="alert alert-error">❌ <%= error %></div><% } %>

  <div class="card">
    <div class="table-scroll">
    <table>
      <thead><tr><th>ID</th><th>Restaurant Name</th><th>Email</th><th>Status</th><th>Messages</th><th>Plan</th><th>📢 Credits</th><th>💳 Payment Gateway</th><th>Created</th><th>Actions</th></tr></thead>
      <tbody>
      <% vendors.forEach(v => { %>
        <% const sub = v.sub; %>
        <tr>
          <td><%= v.id %></td>
          <td><strong><%= v.name %></strong></td>
          <td><%= v.email %></td>
          <td><span class="badge <%= v.is_active?'active':'inactive' %>"><%= v.is_active?'Active':'Inactive' %></span></td>
          <td>
            <% if(sub){ %>
              <% const pct = sub.messages_total > 0 ? Math.round((sub.messages_used/sub.messages_total)*100) : 0; %>
              <div style="font-size:12px;font-weight:600;margin-bottom:3px"><%= sub.messages_used %>/<%= sub.messages_total %> (<%= pct %>%)</div>
              <div style="background:#e5e7eb;border-radius:4px;height:6px;width:100px">
                <div style="background:<%= pct>=90?'#e53935':pct>=70?'#f59e0b':'#1db954' %>;height:100%;border-radius:4px;width:<%= Math.min(pct,100) %>%"></div>
              </div>
            <% } else { %><span style="color:#9ca3af;font-size:12px">No sub</span><% } %>
          </td>
          <td style="font-size:12px">
            <% if(sub){ %>
              <span style="font-weight:600"><%= sub.plan_name %></span><br>
              <span style="color:<%= sub.status==='active'?'#065f46':sub.status==='expired'?'#991b1b':'#374151' %>"><%= sub.status %></span>
              <% if(sub.end_date){ %><br><span style="color:#6b7280">till <%= new Date(sub.end_date).toLocaleDateString('en-IN') %></span><% } %>
            <% } else { %><span style="color:#9ca3af">—</span><% } %>
          </td>
          <td>
            <span style="font-weight:700;font-size:14px;color:<%= v.broadcast_credits>0?'#1db954':'#9ca3af' %>">
              <%= v.broadcast_credits %>
            </span>
            <button class="btn btn-ghost" style="padding:3px 8px;font-size:11px;margin-left:4px"
              onclick="openAddCredits(<%= v.id %>,'<%= v.name %>')">+ Add</button>
          </td>
          <td>
            <form method="POST" action="/superadmin/vendors/<%= v.id %>/payment-mode" onchange="this.submit()">
              <select name="payment_gateway_mode" style="padding:4px 8px;border:1px solid #d1d5db;border-radius:6px;font-size:12px;font-family:inherit">
                <option value="platform" <%= v.payment_gateway_mode==='platform'?'selected':'' %>>🟢 FoodBot Gateway</option>
                <option value="own" <%= v.payment_gateway_mode==='own'?'selected':'' %>>🏪 Vendor's Own</option>
              </select>
            </form>
            <% if(v.payment_gateway_mode==='platform'){ %>
              <a href="/superadmin/wallet?vendor_id=<%= v.id %>" style="font-size:11px;color:#6366f1;display:inline-block;margin-top:4px">💰 View Wallet</a>
            <% } %>
          </td>
          <td style="color:#6b7280;font-size:12px"><%= new Date(v.created_at).toLocaleDateString('en-IN') %></td>
          <td style="display:flex;gap:6px;flex-wrap:wrap">
            <a href="/superadmin/vendors/<%= v.id %>/features" class="btn btn-ghost">⚙️ Features</a>
            <button class="btn btn-ghost" onclick="openTopup(<%= v.id %>,'<%= v.name %>')">💬 Top-up</button>
            <button class="btn btn-ghost" onclick="openResetPass(<%= v.id %>)">🔑 Password</button>
            <button class="btn btn-ghost" onclick="toggleVendor(<%= v.id %>)"><%= v.is_active?'🔴 Disable':'🟢 Enable' %></button>
            <button class="btn btn-red" onclick="delVendor(<%= v.id %>,'<%= v.name %>')">🗑️</button>
          </td>
        </tr>
      <% }) %>
      <% if(!vendors.length){ %>
        <tr><td colspan="10" style="text-align:center;padding:32px;color:#6b7280">No vendors yet.</td></tr>
      <% } %>
      </tbody>
    </table>
    </div>
  </div>
</div>

<!-- Add Vendor Modal -->
<div class="modal-overlay" id="addModal">
  <div class="modal">
    <button class="close" onclick="document.getElementById('addModal').classList.remove('open')">×</button>
    <h2>Add New Vendor</h2>
    <form method="POST" action="/superadmin/vendors/create">
      <div class="form-group"><label>Restaurant Name</label><input name="name" required placeholder="e.g. Pizza Palace"></div>
      <div class="form-group"><label>Email</label><input type="email" name="email" required placeholder="owner@restaurant.com"></div>
      <div class="form-group"><label>Password</label><input type="password" name="password" required placeholder="Min 8 characters" minlength="6"></div>
      <div class="form-group"><label>Trial Messages</label><input type="number" name="trial_messages" value="50" min="0" placeholder="e.g. 50"></div>
      <div class="form-group">
        <label>Payment Gateway (Online Orders)</label>
        <select name="payment_gateway_mode" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;font-family:inherit;font-size:13px">
          <option value="platform" selected>🟢 FoodBot Gateway (recommended — vendor ki keys ki zaroorat nahi)</option>
          <option value="own">🏪 Vendor's Own Razorpay Keys</option>
        </select>
        <div style="font-size:11px;color:#6b7280;margin-top:3px">
          FoodBot Gateway: payment FoodBot ke Razorpay account mein aayega, vendor "Wallet" tab mein dekh sakega.<br>
          Vendor's Own: vendor apni Razorpay keys /admin/settings mein save karega, payment seedha unke account mein aayega.
        </div>
      </div>
      <button type="submit" class="btn btn-indigo" style="width:100%;padding:10px;font-size:14px">Create Vendor</button>
    </form>
  </div>
</div>

<!-- Reset Password Modal -->
<div class="modal-overlay" id="resetPassModal">
  <div class="modal">
    <button class="close" onclick="document.getElementById('resetPassModal').classList.remove('open')">×</button>
    <h2>🔑 Reset Password</h2>
    <form method="POST" id="resetPassForm">
      <div class="form-group"><label>New Password</label><input type="password" name="new_password" required minlength="6"></div>
      <button type="submit" class="btn btn-indigo" style="width:100%;padding:10px">Reset Password</button>
    </form>
  </div>
</div>

<!-- Top-up Modal -->
<div class="modal-overlay" id="topupModal">
  <div class="modal">
    <button class="close" onclick="document.getElementById('topupModal').classList.remove('open')">×</button>
    <h2>💬 Add Messages</h2>
    <p id="topupVendorName" style="font-size:13px;color:#6b7280;margin-bottom:14px"></p>
    <form method="POST" id="topupForm">
      <div class="form-group"><label>Messages to Add</label><input type="number" name="messages" required min="1" placeholder="e.g. 500"></div>
      <button type="submit" class="btn btn-indigo" style="width:100%;padding:10px">Add Messages</button>
    </form>
  </div>
</div>

<div style="margin-top:8px;text-align:right;max-width:1100px;margin:8px auto 0">
  <a href="/superadmin/plans" class="btn btn-indigo">📋 Manage Plans</a>
</div>

<!-- Add Broadcast Credits Modal -->
<div class="modal-overlay" id="addCreditsModal">
  <div class="modal">
    <button class="close" onclick="document.getElementById('addCreditsModal').classList.remove('open')">×</button>
    <h2>📢 Broadcast Credits Add Karo</h2>
    <p style="font-size:13px;color:#6b7280;margin-bottom:16px">Vendor: <strong id="addCreditsVendorName"></strong></p>
    <form method="POST" id="addCreditsForm">
      <div class="form-group">
        <label>Credits</label>
        <input type="number" name="credits" required min="1" placeholder="e.g. 100" style="padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;width:100%;font-family:inherit;font-size:13px">
        <div style="font-size:11px;color:#6b7280;margin-top:3px">1 credit = 1 customer ko 1 broadcast</div>
      </div>
      <div class="form-group">
        <label>Note (optional)</label>
        <input type="text" name="note" placeholder="e.g. Trial credits, Bonus, etc." style="padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;width:100%;font-family:inherit;font-size:13px">
      </div>
      <button type="submit" class="btn btn-indigo" style="width:100%;padding:10px;font-size:14px">✅ Add Credits</button>
    </form>
  </div>
</div>

<script>
function openResetPass(id) {
  document.getElementById('resetPassForm').action = '/superadmin/vendors/'+id+'/reset-password';
  document.getElementById('resetPassModal').classList.add('open');
}
function openTopup(id, name) {
  document.getElementById('topupForm').action = '/superadmin/vendors/'+id+'/topup';
  document.getElementById('topupVendorName').textContent = 'Vendor: ' + name;
  document.getElementById('topupModal').classList.add('open');
}
function openAddCredits(id, name) {
  document.getElementById('addCreditsForm').action = '/superadmin/vendors/'+id+'/add-credits';
  document.getElementById('addCreditsVendorName').textContent = name;
  document.getElementById('addCreditsModal').classList.add('open');
}
function toggleVendor(id) {
  const f = document.createElement('form'); f.method='POST'; f.action='/superadmin/vendors/'+id+'/toggle';
  document.body.appendChild(f); f.submit();
}
function delVendor(id, name) {
  if(!confirm('Delete vendor "'+name+'"? This will delete ALL their data!')) return;
  const f = document.createElement('form'); f.method='POST'; f.action='/superadmin/vendors/'+id+'/delete';
  document.body.appendChild(f); f.submit();
}
</script>
</body>
</html>
