<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kitchen Screen Login — Food Bot</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --green: #1db954;
    --dark-bg: #121212;
    --card-bg: #1e1e1e;
    --text-primary: #f3f4f6;
    --text-secondary: #9ca3af;
    --border: #374151;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background-color: var(--dark-bg);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 20px;
  }
  .login-card {
    background-color: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    width: 100%;
    max-width: 400px;
    padding: 32px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
  .header {
    text-align: center;
    margin-bottom: 28px;
  }
  .header h1 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .header h1 span {
    color: var(--green);
  }
  .header p {
    font-size: 13px;
    color: var(--text-secondary);
  }
  .form-group {
    margin-bottom: 20px;
  }
  .form-group label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 6px;
    text-transform: uppercase;
  }
  .form-control {
    width: 100%;
    background-color: #2b2b2b;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text-primary);
    padding: 12px 16px;
    font-family: inherit;
    font-size: 14px;
    outline: none;
    transition: 0.15s;
  }
  .form-control:focus {
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgba(29, 185, 84, 0.15);
  }
  .btn {
    width: 100%;
    background-color: var(--green);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 12px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.15s;
    margin-top: 8px;
  }
  .btn:hover {
    background-color: #17a347;
  }
  .alert {
    background-color: #7f1d1d;
    border: 1px solid #b91c1c;
    color: #fca5a5;
    font-size: 13px;
    padding: 10px 14px;
    border-radius: 8px;
    margin-bottom: 20px;
  }
</style>
</head>
<body>

<div class="login-card">
  <div class="header">
    <h1>👨‍🍳 Kitchen<span>Screen</span></h1>
    <p>Select your restaurant and enter passcode to login</p>
  </div>

  <% if (error) { %>
    <div class="alert">⚠️ <%= error %></div>
  <% } %>

  <form method="POST" action="/kitchen/login">
    <div class="form-group">
      <label>Restaurant / Shop</label>
      <select name="vendor_id" class="form-control" required>
        <option value="" disabled selected>Choose Restaurant...</option>
        <% vendors.forEach(v => { %>
          <option value="<%= v.id %>"><%= v.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label>Kitchen Passcode</label>
      <input type="password" name="passcode" class="form-control" placeholder="Enter 4-digit code" required autocomplete="off" inputmode="numeric" pattern="[0-9]*">
    </div>

    <button type="submit" class="btn">🔑 Enter Kitchen Screen</button>
  </form>
</div>

</body>
</html>
